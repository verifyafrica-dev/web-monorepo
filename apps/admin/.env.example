# Canonical URLs — see packages/config/src/domains.ts and README
# Local / dev.* / test.* → VITE_API_BASE_URL only (no Live↔Test switcher)
# Production            → VITE_LIVE_API_BASE_URL + VITE_TEST_API_BASE_URL (switcher)

VITE_PUBLIC_SUPABASE_ANON_KEY=""
VITE_PUBLIC_SUPABASE_URL=""
VITE_POSTHOG_KEY=""

SHADCNBLOCKS_API_KEY=""

# Required everywhere. On production this is also used for deploy detection.
VITE_API_BASE_URL="http://localhost:8300/api"

# Production Live↔Test switcher only (ignored on local/dev/test). Fallbacks:
# live → https://api.verifyafrica.io/api
# test → https://test.api.verifyafrica.io/api
# VITE_LIVE_API_BASE_URL="https://api.verifyafrica.io/api"
# VITE_TEST_API_BASE_URL="https://test.api.verifyafrica.io/api"

# File uploads use Cloudflare R2 via backend presigned URLs — no Firebase.

# Pusher (public key + cluster only — never put the secret in VITE_*)
VITE_PUSHER_KEY="eff2b56c13946d806010"
VITE_PUSHER_CLUSTER="eu"
