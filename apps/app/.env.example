# Canonical URLs — see packages/config/src/domains.ts
# Production:  https://app.verifyafrica.io       → api.verifyafrica.io  (main)
# Test hosts:  https://test.app.verifyafrica.io  → test.api              (main)
# Dev:         https://dev.app.verifyafrica.io   → test.api              (dev)
# Local API:   http://localhost:8300/api

VITE_PUBLIC_SUPABASE_ANON_KEY=""
VITE_PUBLIC_SUPABASE_URL=""
VITE_POSTHOG_KEY=""

SHADCNBLOCKS_API_KEY=""

# Mirrors backend ENV_STATE: production | sandbox | dev (unused in UI yet).
VITE_ENV_STATE="dev"

VITE_API_BASE_URL="https://api.verifyafrica.io/api"

# Stripe (wallet top-up embedded checkout)
VITE_STRIPE_PUBLISHABLE_KEY=""

# Cloudflare R2 uploads are handled by the backend via temporary presigned URLs.
# Do not put R2 access keys in the Vite client.
